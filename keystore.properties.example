# Copy this file to keystore.properties (git-ignored) for LOCAL release builds only.
# CI reads the same four values from environment variables/secrets instead --
# see .github/workflows/android-build.yml. Never commit the real
# keystore.properties or the .jks/.keystore file itself.

storeFile=/absolute/path/to/habitsfirst-release.jks
storePassword=CHANGE_ME
keyAlias=habitsfirst
keyPassword=CHANGE_ME
