# Copy to .env (git-ignored) and fill in real values. Every var here has a safe
# default or a clear "disabled until set" behavior -- see src/config.js -- so the
# server starts and is useful for local development even with this file untouched,
# except real photo verification and real Play purchase verification, which need
# ANTHROPIC_API_KEY and the Google Play service-account vars respectively.

PORT=8787

# Server-side Claude API key for photo verification. Habits with photo verification
# and the morning check-in both call POST /v1/verify-photo, which forwards to
# Anthropic using this key -- it never ships inside the Android app. Get one at
# https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Where the SQLite database file is written. Fine to leave as-is for local dev;
# point it at a persistent volume in production.
DATABASE_PATH=./data/locke.sqlite3

# -- Google Play purchase verification (POST /v1/purchases/verify, /v1/rtdn) --------
# Needed to verify a purchaseToken against the real Play Developer API and to
# process Real-time Developer Notifications. Without these set, verification falls
# back to trusting the client-reported product/tier (fine for development against
# Play's license-tester sandbox, not for production).
GOOGLE_PLAY_PACKAGE_NAME=com.locke.app
# Path to a Google Cloud service-account JSON key with access to the Play Developer
# API (Play Console -> Setup -> API access), OR set GOOGLE_APPLICATION_CREDENTIALS
# to the same effect (the googleapis client picks that env var up automatically).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=

# Shared secret devices must not know -- rotate this to invalidate every issued
# device token at once (e.g. after a leak). Leave unset for local dev; a random
# value is generated at boot and logged instead, which is fine until the process
# restarts (every issued token stops working across a restart if you do that).
DEVICE_TOKEN_SECRET=
