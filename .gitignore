*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/captures/
.externalNativeBuild/
.cxx/
local.properties

# App module build output
app/build/

# Log/OS
*.log

# Keystores and signing credentials (never commit these)
*.jks
*.keystore
keystore.properties

# ...except the debug keystore: it's intentionally checked in (see
# app/build.gradle.kts) so every debug build -- local or CI -- shares one stable
# signature and can update over a previously installed build instead of needing
# an uninstall first. Its passwords are the well-known Android debug defaults,
# not a secret.
!app/debug.keystore
