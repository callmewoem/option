    <string name="app_name">Habits First</string>
    <string name="accessibility_service_description">Habits First uses this to notice when you open an app you\'ve chosen to block, so it can show your habit checklist until you\'ve completed today\'s habits.</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Do your habits.\nThen use your apps.</string>
    <string name="onboarding_welcome_subtitle">Habits First locks the apps that distract you most and only unlocks them once you\'ve finished your habits for the day.</string>
