<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Where the camera app writes a freshly captured verification photo. -->
    <cache-path name="verification_captures" path="verification_captures/" />
    <!-- Where exported "today's stats" share-card PNGs are written before handing a content:// Uri to the share sheet. -->
    <cache-path name="share_cards" path="share_cards/" />

    <!-- Where StatsExportUtil writes CSV/JSON data exports before sharing them. -->
    <cache-path name="stats_export" path="stats_export/" />
</paths>
